generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ========== スタッフ ==========

model Staff {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      StaffRole @default(STAFF)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum StaffRole {
  ADMIN
  STAFF
}

// ========== 顧客 ==========

model Customer {
  id           String        @id @default(cuid())
  name         String
  nameKana     String
  phone        String?
  email        String?
  birthday     DateTime?
  allergies    String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  treatments   Treatment[]
  reservations Reservation[]
}

// ========== メニュー ==========

enum MenuItemType {
  TREATMENT
  RETAIL
}

model MenuItem {
  id                   String                @id @default(cuid())
  name                 String
  price                Int
  durationMin          Int
  menuType             MenuItemType          @default(TREATMENT)
  isActive             Boolean               @default(true)
  sortOrder            Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  treatmentMenuItems   TreatmentMenuItem[]
  reservationMenuItems ReservationMenuItem[]
}

// ========== 施術履歴 ==========

model Treatment {
  id          String              @id @default(cuid())
  customerId  String
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date        DateTime
  totalAmount Int
  discount    Int                 @default(0)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  menuItems   TreatmentMenuItem[]
}

model TreatmentMenuItem {
  id          String    @id @default(cuid())
  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id])
  price       Int
}

// ========== 予約 ==========

model Reservation {
  id         String                @id @default(cuid())
  customerId String
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startTime  DateTime
  endTime    DateTime
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  menuItems  ReservationMenuItem[]
}

model ReservationMenuItem {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id])
}

// ========== 在庫 ==========

model InventoryCategory {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     InventoryItem[]
}

model InventoryItem {
  id             String            @id @default(cuid())
  categoryId     String
  category       InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  quantity       Float
  unit           String
  alertThreshold Float
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}
