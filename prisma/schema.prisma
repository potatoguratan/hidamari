generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ========== スタッフ ==========

model Staff {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      StaffRole @default(STAFF)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum StaffRole {
  ADMIN
  STAFF
}

// ========== 顧客 ==========

model Customer {
  id           String        @id @default(cuid())
  name         String
  nameKana     String
  phone        String?
  email        String?
  birthday     DateTime?
  allergies    String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  treatments   Treatment[]
  reservations Reservation[]
  sales        Sale[]
}

// ========== メニュー ==========

enum MenuItemType {
  TREATMENT
  RETAIL
}

model MenuItem {
  id                   String                @id @default(cuid())
  name                 String
  price                Int
  durationMin          Int
  menuType             MenuItemType          @default(TREATMENT)
  isActive             Boolean               @default(true)
  sortOrder            Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  treatmentMenuItems   TreatmentMenuItem[]
  reservationMenuItems ReservationMenuItem[]
  inventoryItemId      String?               @unique
  inventoryItem        InventoryItem?        @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  saleLines            SaleLine[]
}

// ========== 施術履歴 ==========

model Treatment {
  id          String              @id @default(cuid())
  customerId  String
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date        DateTime
  totalAmount Int
  discount    Int                 @default(0)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  menuItems   TreatmentMenuItem[]
}

model TreatmentMenuItem {
  id          String    @id @default(cuid())
  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id])
  price       Int
}

// ========== 予約 ==========

model Reservation {
  id         String                @id @default(cuid())
  customerId String
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startTime  DateTime
  endTime    DateTime
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  menuItems  ReservationMenuItem[]
  sales      Sale[]
}

model ReservationMenuItem {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id])
}

// ========== Sales ==========

model Sale {
  id             String       @id @default(cuid())
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reservationId  String?
  reservation    Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  soldAt         DateTime     @default(now())
  subtotalAmount Int
  discountAmount Int          @default(0)
  totalAmount    Int
  notes          String?
  createdAt      DateTime     @default(now())
  lines          SaleLine[]

  @@index([soldAt])
  @@index([customerId, soldAt])
  @@index([reservationId])
}

model SaleLine {
  id              String         @id @default(cuid())
  saleId          String
  sale            Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  menuItemId      String?
  menuItem        MenuItem?      @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  itemType        MenuItemType
  itemName        String
  unitPrice       Int
  quantity        Int            @default(1)
  originalAmount  Int
  discountAmount  Int            @default(0)
  finalAmount     Int
  createdAt       DateTime       @default(now())

  @@index([saleId])
  @@index([menuItemId])
  @@index([inventoryItemId])
  @@index([itemType])
}

// ========== 在庫 ==========

model InventoryCategory {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     InventoryItem[]
}

model InventoryItem {
  id             String            @id @default(cuid())
  categoryId     String
  category       InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  itemType       InventoryItemType @default(MATERIAL)
  name           String
  quantity       Float
  unit           String
  alertThreshold Float
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  menuItem       MenuItem?
  saleLines      SaleLine[]
}

enum InventoryItemType {
  MATERIAL
  RETAIL
}
